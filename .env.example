# Bu dosya yalnızca örnektir; gerçek değerleri buraya YAZMA.
# Bilgisayarında çalışırken bu dosyayı .env.local adıyla kopyalayıp doldur.
# .env.local dosyası .gitignore sayesinde GitHub'a gönderilmez.

# Vercel → Storage → Neon Postgres bağlandığında otomatik eklenir
DATABASE_URL=

# 1. Seçenek (Milli LLM): EVREN API (https://evren.ssyz.org.tr/api-keys)
EVREN_API_KEY=
# İsteğe bağlı EVREN modeli (varsayılan: deepseek-v4.1-flash)
EVREN_MODEL=

# 2. Seçenek: Google AI Studio'dan alınan Gemini API anahtarı
GEMINI_API_KEY=
# İsteğe bağlı Gemini modeli (varsayılan: gemini-3.5-flash)
GEMINI_MODEL=

# İsteğe bağlı: 'evren' veya 'gemini' (boşsa hangisi tanımlıysa o kullanılır)
AI_PROVIDER=

# İsteğe bağlı: kullanıcı başına günlük soru hakkı (boş bırakılırsa 10)
GUNLUK_SORU_LIMITI=
